<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App identity -->
    <key>CFBundleIdentifier</key>
    <string>com.focusflip.app</string>
    <key>CFBundleDisplayName</key>
    <string>FocusFlip</string>
    <key>CFBundleExecutable</key>
    <string>FocusFlip</string>
    <key>CFBundleName</key>
    <string>FocusFlip</string>
    <key>CFBundleShortVersionString</key>
    <string>1.4.0</string>
    <key>CFBundleVersion</key>
	<string>5</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <!-- Minimum OS -->
    <key>MinimumOSVersion</key>
    <string>15.0</string>

    <!-- Launch screen (empty dict = system default, prevents compatibility mode crash) -->
    <key>UILaunchScreen</key>
    <dict/>

    <!-- Orientations -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Background modes: keep timer alive in background -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <!-- Hide status bar for immersive flip clock -->
    <key>UIStatusBarHidden</key>
    <false/>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <true/>

    <!-- URL Scheme for deep links / shortcuts -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.focusflip.app</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>focusflip</string>
            </array>
        </dict>
    </array>

    <!-- Live Activity / ActivityKit support (iOS 16.1+) -->
    <key>NSSupportsLiveActivities</key>
    <true/>

    <!-- Privacy: haptics & notifications -->
    <key>NSUserNotificationsUsageDescription</key>
    <string>FocusFlip sends notifications when a focus or break session ends.</string>
</dict>
</plist>
